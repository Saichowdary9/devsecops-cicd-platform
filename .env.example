# Copy this file to .env and adjust values for your environment.
# None of these are required for the site to run — they are optional
# overrides read at build time via Vite's import.meta.env.
#
# Never commit a real .env file. It is already listed in .gitignore.

# Public URL the site will be deployed at (used for canonical/OG tags
# if you wire that up later).
VITE_SITE_URL=https://example.com

# Optional form submission endpoint (e.g. a Formspree endpoint) for the
# Contact section. If left unset, the contact form falls back to
# opening the visitor's email client with a pre-filled message.
VITE_CONTACT_FORM_ENDPOINT=

# Optional override for the resume file path if you host it somewhere
# other than /resume/Sai-Kukkapalli-Resume.pdf.
VITE_RESUME_URL=
